# =============================================================================
# Handcrafted Hearthwood — unified environment (monorepo)
#
#   cp .env.example .env    # then set strong secrets before `docker compose up`
#
# The root docker-compose.yml injects these values into the backend and
# frontend containers. Compose FAILS FAST if a required variable is missing
# (the `:?` guards) — by design.
#
# NEVER commit the real .env (it is gitignored).
# =============================================================================

# ============ 1. INFRASTRUCTURE (postgres / redis / minio) ====================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=hearthwood
POSTGRES_PASSWORD=change-me-strong-pg-password
POSTGRES_DB=hearthwood
POSTGRES_PORT=5432

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO (S3-compatible object storage) --------------------------------------
MINIO_ROOT_USER=hearthwood
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============ 2. BACKEND (FastAPI, container :8010) ============================

DEBUG=false
BACKEND_PORT=8010

# S3 credentials default to the MinIO root credentials above.
# Override only if you switch to real AWS S3 (or another S3 provider):
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=hearthwood-media
# Public host the browser uses to fetch media. The backend reaches MinIO
# via the internal network name; the browser needs this public origin.
# (On a VPS with a CDN/reverse proxy, set this to that origin.)
MEDIA_PUBLIC_URL=http://localhost:9000

# JSON list of browser origins the API allows (CORS).
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# --- Secure OTP auth (sms.ir + JWT) ---------------------------------------
# Your sms.ir API key (https://sms.ir). Leave EMPTY to disable OTP
# dispatch (the endpoint answers 503 and never bills the provider).
SMS_IR_API_KEY=
# sms.ir Verify template carrying the OTP (parameter name: CODE).
SMS_IR_TEMPLATE_ID=100000
# HS256 signing secret for the JWT access tokens — set a long random string.
JWT_SECRET=change-me-strong-jwt-secret

# ============ 3. FRONTEND (TanStack Start, container :8080) ====================

FRONTEND_PORT=8080

# API base URL the storefront calls. Browsers reach the backend through the
# host port mapped in docker-compose.yml (BACKEND_PORT).
# NOTE: the currently committed frontend has this value hard-coded in
# src/lib/api.ts; this variable is wired into the Docker build so the app
# can be made env-driven later without changing the build pipeline.
VITE_API_BASE_URL=http://localhost:8010/api/v1