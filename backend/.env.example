# =============================================================================
# Handcrafted Hearthwood — environment
# Copy this file to `.env` and set strong values before running
# `docker compose up`. NEVER commit the real `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
DEBUG=false

# --- PostgreSQL (docker-compose + SQLAlchemy) --------------------------------
POSTGRES_USER=hearthwood
POSTGRES_PASSWORD=change-me-strong-pg-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hearthwood

# --- Redis (docker-compose + redis-py) ----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_DB=0

# --- MinIO / S3 (docker-compose + aioboto3) ----------------------------------
MINIO_ROOT_USER=hearthwood
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=hearthwood
S3_SECRET_ACCESS_KEY=change-me-strong-minio-key
S3_REGION=us-east-1
S3_BUCKET=hearthwood-media

# --- CORS (pydantic-settings parses JSON lists) --------------------------------
# CORS_ORIGINS=["http://localhost:8080"]